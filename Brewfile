# Homebrew dependencies for this repo. Install with: brew bundle
# CMake configures the Ferrum-Chem C++ adapter and pinned RDKit source build.
brew "cmake"
# Use the upstream LLVM/Clang compiler rather than Apple's Clang frontend.
brew "llvm"
# Cargo and Rustc are resolved through Homebrew Rustup for controlled wheel builds.
brew "rustup"
# Python 3.12 is the pinned interpreter for this repo's tooling.
brew "python@3.12"
